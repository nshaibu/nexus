{
  "title": "Volnux — Overview",
  "uid": "volnux-overview",
  "tags": ["volnux"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "panels": [

    {
      "id": 1,
      "title": "Workflow Executions (24h)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "increase(volnux_workflow_duration_seconds_count[24h])",
        "legendFormat": "Total"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      }
    },

    {
      "id": 2,
      "title": "Active Workers",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "count(up{job=~\"volnux-worker.*\"} == 1)",
        "legendFormat": "Workers"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "value": 0, "color": "red" },
            { "value": 1, "color": "yellow" },
            { "value": 3, "color": "green" }
          ]
        }
      }
    },

    {
      "id": 3,
      "title": "Pending HITL Approvals",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(volnux_hitl_pending_count)",
        "legendFormat": "Pending"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "value": 0, "color": "green" },
            { "value": 50, "color": "yellow" },
            { "value": 100, "color": "red" }
          ]
        }
      }
    },

    {
      "id": 4,
      "title": "Checkpoint Queue Depth",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(volnux_checkpoint_queue_depth)",
        "legendFormat": "Queue"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "value": 0,    "color": "green" },
            { "value": 500,  "color": "yellow" },
            { "value": 1000, "color": "red" }
          ]
        }
      }
    },

    {
      "id": 5,
      "title": "Executor Pool Utilisation",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "100 * (1 - sum(volnux_executor_pool_available) / sum(volnux_executor_pool_active))",
        "legendFormat": "Used %"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "unit": "percent",
        "thresholds": {
          "steps": [
            { "value": 0,  "color": "green" },
            { "value": 70, "color": "yellow" },
            { "value": 90, "color": "red" }
          ]
        }
      }
    },

    {
      "id": 6,
      "title": "Workflow Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(volnux_workflow_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(volnux_workflow_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(volnux_workflow_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }
      }
    },

    {
      "id": 7,
      "title": "Event Error Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(rate(volnux_event_errors_total[5m])) by (event)",
        "legendFormat": "{{event}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10 }
        }
      }
    },

    {
      "id": 8,
      "title": "Trigger Fire Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(rate(volnux_trigger_fire_count[5m])) by (workflow, trigger)",
        "legendFormat": "{{workflow}} / {{trigger}}"
      }],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },

    {
      "id": 9,
      "title": "Checkpoint Write Latency",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(volnux_checkpoint_write_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(volnux_checkpoint_write_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },

    {
      "id": 10,
      "title": "Agent Token Usage (per provider)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "sum(rate(volnux_agent_token_count[5m])) by (provider)",
        "legendFormat": "{{provider}}"
      }],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      }
    },

    {
      "id": 11,
      "title": "Agent Governance Violations",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "increase(volnux_agent_governance_violations_total[1h])",
        "legendFormat": "Violations"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "fixedColor": "red", "mode": "fixed" }
        }
      },
      "alert": {
        "name": "Agent Governance Violation",
        "message": "An agent attempted to call an undeclared tool or handoff target.",
        "conditions": [{
          "evaluator": { "params": [0], "type": "gt" },
          "operator": { "type": "and" },
          "query": { "params": ["A", "5m", "now"] },
          "reducer": { "params": [], "type": "sum" },
          "type": "query"
        }]
      }
    }

  ],

  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name":       "workflow",
        "label":      "Workflow",
        "type":       "query",
        "datasource": "Prometheus",
        "query":      "label_values(volnux_workflow_duration_seconds_count, workflow)",
        "refresh":    2,
        "multi":      true,
        "includeAll": true,
        "current":    { "text": "All", "value": "$__all" }
      }
    ]
  }
}

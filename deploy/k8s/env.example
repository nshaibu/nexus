# .env.example
#
# Local development environment variables.
# Copy to .env and fill in values:
#   cp .env.example .env
#
# These are loaded automatically by `volnux dev` if python-dotenv is installed.
# For Docker Compose, use docker-compose.yml environment sections instead.
#
# NEVER commit .env to source control — it is gitignored.
# NEVER put production secrets here — use Kubernetes Secrets or a secrets manager.

# ── Environment ────────────────────────────────────────────────────────────────
VOLNUX_ENV=development
VOLNUX_LOG_LEVEL=DEBUG
VOLNUX_LOG_FORMAT=text

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Local PostgreSQL — start with: docker compose up -d postgres
VOLNUX_POSTGRES_HOST=localhost
VOLNUX_POSTGRES_PORT=5432
VOLNUX_POSTGRES_DB=volnux
VOLNUX_POSTGRES_USER=volnux
VOLNUX_POSTGRES_PASSWORD=volnux_dev_password
VOLNUX_POSTGRES_SSL=disable

# ── Redis — Checkpoints ────────────────────────────────────────────────────────
# Start with: docker compose up -d redis-checkpoints
VOLNUX_REDIS_CHECKPOINT_URL=redis://localhost:6379/0

# ── Redis — Broker (Celery) ────────────────────────────────────────────────────
# Start with: docker compose up -d redis-broker
VOLNUX_REDIS_BROKER_URL=redis://localhost:6380/0

# ── Command channel ────────────────────────────────────────────────────────────
VOLNUX_CHANNEL_BACKEND=redis

# ── API server ─────────────────────────────────────────────────────────────────
VOLNUX_API_HOST=127.0.0.1
VOLNUX_API_PORT=8080
VOLNUX_API_DOCS=true
VOLNUX_NODE_ID=dev-node

# ── JWT (development only — never use this value in production) ───────────────
VOLNUX_JWT_SECRET=dev_only_jwt_secret_change_before_production

# ── OTel ───────────────────────────────────────────────────────────────────────
# Start OTel collector with: docker compose up -d otel-collector
VOLNUX_OTEL_ENABLED=true
VOLNUX_OTEL_ENDPOINT=http://localhost:4317
VOLNUX_OTEL_PROTOCOL=grpc

# ── Prometheus ─────────────────────────────────────────────────────────────────
VOLNUX_PROMETHEUS_PORT=9464

# ── Checkpoint settings ────────────────────────────────────────────────────────
VOLNUX_CHECKPOINT_DRAIN_TIMEOUT=30

# ── LLM providers ─────────────────────────────────────────────────────────────
# Ollama — runs locally, no API key required
# Install: https://ollama.ai — then: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# OpenAI — comment out if not using
# OPENAI_API_KEY=sk-...

# Anthropic — comment out if not using
# ANTHROPIC_API_KEY=sk-ant-...

# Gemini — uses google-genai SDK, NOT google-generativeai (deprecated)
# GEMINI_API_KEY=...

# ── HITL adapters ──────────────────────────────────────────────────────────────
# Slack — comment out if not testing Slack HITL adapter
# VOLNUX_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# VOLNUX_SLACK_SIGNING_SECRET=...
# VOLNUX_SLACK_CHANNEL=#volnux-dev-approvals

# ── EventHub ───────────────────────────────────────────────────────────────────
# Only needed if consuming packages from EventHub
# VOLNUX_EVENTHUB_API_KEY=...
VOLNUX_EVENTHUB_URL=https://eventhub.volnux.dev
